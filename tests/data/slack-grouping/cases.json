{
  "about": "A labelled set for the slack-channel-grouping prompt. Every workspace, channel, topic, purpose and domain is made up, and every domain ends in .example. Each case is one person's channels and what their wiki is for. `read` are channels the wiki should read: a ticked row should take each in. `skip` are channels no ticked row should take in. A channel in neither is left to the model. `pattern` names a pattern a good grouping gives, scored apart and never needed to pass.",
  "cases": [
    {
      "id": "research-lab",
      "workspace": "The wiki of a protein research lab: one article for each of its projects, each collaborating institute and each instrument it runs.",
      "channels": [
        {"name": "proj-kinase", "topic": "Kinase binding assays", "members": 6},
        {"name": "proj-folding", "topic": "Folding simulations", "members": 5},
        {"name": "proj-membrane", "purpose": "Membrane transport project", "members": 4},
        {"name": "with-northfield-uni", "topic": "Joint grant with Northfield", "shared": true, "outside_domains": ["northfield-uni.example"], "members": 9},
        {"name": "lab-meeting", "purpose": "Weekly progress across all projects", "members": 18},
        {"name": "journal-club", "topic": "Papers we read on Fridays", "members": 15},
        {"name": "it-helpdesk", "purpose": "Laptops, accounts and printers", "members": 40},
        {"name": "random", "members": 41},
        {"name": "lunch-club", "members": 12}
      ],
      "read": ["proj-kinase", "proj-folding", "proj-membrane", "with-northfield-uni", "lab-meeting"],
      "skip": ["it-helpdesk", "random", "lunch-club"],
      "pattern": "proj-*"
    },
